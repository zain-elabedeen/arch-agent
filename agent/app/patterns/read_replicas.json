  "category": "scaling",
  "summary": "Scale read-heavy traffic by routing read queries to replicas and reducing load on the primary database.",
  "use_when": [
    {
      "kind": "signal",
      "key": "db_latency_p95_ms",
      "operator": "gte",
      "value": 300,
