      "kind": "signal",
      "key": "error_rate",
      "operator": "gte",
      "value": 0.1,
      "message": "High error rate should be stabilized before scaling reads."
    }
  ],
  "solutions": [
    "Introduce read replicas",
    "Route read traffic to replicas"
  ],
  "tradeoffs": [
    "Replication lag",
    "Eventual consistency",
    "Increased operational complexity"
  ],
  "impact": "high",
  "effort": "medium",
  "confidence": "high",
