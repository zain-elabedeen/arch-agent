ARCHAGENT_ENVIRONMENT=dev
ARCHAGENT_PATTERN_STORE=filesystem
ARCHAGENT_PATTERNS_PATH=agent/app/patterns
ARCHAGENT_POSTGRES_DSN=postgresql+psycopg://archagent:archagent@localhost:5432/archagent
ARCHAGENT_K8S_AUTO_MIGRATE=true
ARCHAGENT_K8S_POLL_INTERVAL_SEC=45
ARCHAGENT_K8S_INCLUDE_NAMESPACES=
ARCHAGENT_K8S_EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease,kubernetes-dashboard

# LLM reasoning layer
ARCHAGENT_LLM_REASONING_ENABLED=true
ARCHAGENT_LLM_PROVIDER=openai
ARCHAGENT_LLM_MODEL=gpt-4o-mini
ARCHAGENT_OPENAI_API_KEY=your_openai_api_key_here
ARCHAGENT_OLLAMA_BASE_URL=http://localhost:11434/v1
