ARCHAGENT_ENVIRONMENT=dev
ARCHAGENT_PATTERN_STORE=filesystem
ARCHAGENT_PATTERNS_PATH=agent/app/patterns
ARCHAGENT_POSTGRES_DSN=postgresql+psycopg://archagent:archagent@localhost:5432/archagent
ARCHAGENT_K8S_AUTO_MIGRATE=true
ARCHAGENT_K8S_POLL_INTERVAL_SEC=45
ARCHAGENT_INGESTION_CONNECTORS=kubernetes,logs
ARCHAGENT_K8S_INCLUDE_NAMESPACES=june-sim
ARCHAGENT_K8S_EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease,kubernetes-dashboard

# Local product control plane. Production must use WorkOS, GCS, Cloud Tasks,
# and a real scanner service instead of the development adapters.
ARCHAGENT_AUTH_MODE=dev
ARCHAGENT_PRODUCT_DATABASE_URL=postgresql+psycopg://archagent:archagent@localhost:5432/archagent
ARCHAGENT_STORAGE_BACKEND=filesystem
ARCHAGENT_LOCAL_STORAGE_PATH=/tmp/archagent-storage
ARCHAGENT_TASK_DISPATCHER=inline
ARCHAGENT_DOCUMENT_SCAN_MODE=dev_allow
ARCHAGENT_COLLECTOR_REGISTRATION_ENDPOINT=https://ingest.archagent.de
ARCHAGENT_COLLECTOR_INGEST_ENDPOINT=https://ingest.archagent.de
# ARCHAGENT_COLLECTOR_REGISTRATION_TOKEN=
# ARCHAGENT_COLLECTOR_CREDENTIAL_FILE=/var/lib/archagent/credential
# ARCHAGENT_COLLECTOR_RETRY_QUEUE_FILE=/var/lib/archagent/retry-queue.json
# ARCHAGENT_COLLECTOR_RETRY_QUEUE_SIZE=20
# ARCHAGENT_COLLECTOR_REQUEST_ATTEMPTS=3
# ARCHAGENT_COLLECTOR_RETRY_INITIAL_SEC=1
ARCHAGENT_GCP_REGION=europe-west1
# ARCHAGENT_GCP_STORAGE_BUCKET=
# ARCHAGENT_GCP_QUARANTINE_BUCKET=
# ARCHAGENT_GCP_TASKS_QUEUE=
# ARCHAGENT_GCP_TASKS_TARGET_URL=
# ARCHAGENT_GCP_TASKS_SERVICE_ACCOUNT=
# ARCHAGENT_GCP_TASKS_OIDC_AUDIENCE=
# ARCHAGENT_SCANNER_SERVICE_URL=
# ARCHAGENT_SCANNER_SERVICE_TOKEN=
# ARCHAGENT_WORKOS_API_KEY=
# ARCHAGENT_WORKOS_CLIENT_ID=
# ARCHAGENT_WORKOS_COOKIE_PASSWORD=
# ARCHAGENT_WORKOS_WEBHOOK_SECRET=
# ARCHAGENT_WORKOS_WEBHOOK_PATH_TOKEN=
# Optional WorkOS role slug for self-serve memberships. Leave unset to use the WorkOS default role.
# ARCHAGENT_WORKOS_SELF_SERVE_ROLE_SLUG=
# ARCHAGENT_WORKOS_REDIRECT_URI=https://api.archagent.de/auth/callback
# ARCHAGENT_WORKOS_SIGN_IN_ENDPOINT=https://api.archagent.de/auth/login
# ARCHAGENT_WORKOS_SIGN_OUT_REDIRECT=https://app.archagent.de/overview
# ARCHAGENT_WORKOS_POST_LOGIN_REDIRECT=https://app.archagent.de/overview
# ARCHAGENT_WORKOS_AUTO_PROVISION_SIGNUPS=true
# ARCHAGENT_CSRF_SECRET=
# ARCHAGENT_COOKIE_SECURE=true
# ARCHAGENT_COOKIE_SAMESITE=lax
# ARCHAGENT_SESSION_COOKIE_MAX_AGE_SEC=2592000
# ARCHAGENT_CSRF_TOKEN_TTL_SEC=2592000
# ARCHAGENT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081,https://app.archagent.de
# ARCHAGENT_ALLOWED_ORIGIN_REGEX=
# ARCHAGENT_INTERNAL_USER_IDS=
ARCHAGENT_LOGS_ENABLED=true
ARCHAGENT_LOG_WINDOW_GRACE_SEC=10
ARCHAGENT_LOG_TAIL_LINES=500

# Architecture knowledge RAG. Enable after indexing docs with:
# python -m agent.app.knowledge.ingest --path agent/app/knowledge_sources
ARCHAGENT_RAG_ENABLED=false
ARCHAGENT_RAG_STORE=postgres
ARCHAGENT_RAG_KNOWLEDGE_PATH=agent/app/knowledge_sources
ARCHAGENT_RAG_EMBEDDING_PROVIDER=google_cloud
ARCHAGENT_RAG_EMBEDDING_MODEL=gemini-embedding-001
ARCHAGENT_RAG_EMBEDDING_DIMENSIONS=1536
ARCHAGENT_RAG_TOP_K=5
ARCHAGENT_RAG_CHUNK_TOKENS=1000
ARCHAGENT_RAG_CHUNK_OVERLAP_TOKENS=180

# LLM log analysis agent
ARCHAGENT_LOG_LLM_ENABLED=false
ARCHAGENT_LOG_SAMPLE_LIMIT=10
# Optional: use a cheaper/smaller model for log classification than the report model.
ARCHAGENT_LOG_LLM_MODEL=
ARCHAGENT_LOG_LLM_MAX_OUTPUT_TOKENS=512

# LLM reasoning agent
ARCHAGENT_LLM_REASONING_ENABLED=true
# Providers: agent_platform_gemini, openai, ollama, agent_platform_claude
ARCHAGENT_LLM_PROVIDER=agent_platform_gemini
ARCHAGENT_LLM_MODEL=gemini-2.5-flash
ARCHAGENT_LLM_TIMEOUT_SEC=20
ARCHAGENT_LLM_MAX_OUTPUT_TOKENS=2500
ARCHAGENT_OLLAMA_BASE_URL=http://localhost:11434/v1

# Datadog LLM Observability for the API process.
# Keep the API key in your local .env file. Compose uses agentless mode because
# it does not start a Datadog Agent.
DD_SITE=datadoghq.eu
DD_LLMOBS_ENABLED=1
DD_LLMOBS_AGENTLESS_ENABLED=1
DD_LLMOBS_ML_APP=arch-agent
DD_API_KEY=

# GCP Gemini / Agent Platform providers
# Claude on Agent Platform example:
# ARCHAGENT_LLM_PROVIDER=agent_platform_claude
# ARCHAGENT_LLM_MODEL=claude-sonnet-4-5@20250929
ARCHAGENT_GCP_LOCATION=global
ARCHAGENT_GCP_GENAI_API_VERSION=v1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional OpenAI fallback:
# ARCHAGENT_LLM_PROVIDER=openai
# ARCHAGENT_LLM_MODEL=gpt-4o-mini
# Also used by RAG embeddings when ARCHAGENT_RAG_EMBEDDING_PROVIDER=openai.
# ARCHAGENT_OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
